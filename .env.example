# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings: Dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). A legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Secret key (sb_secret_...), server only. A legacy "service_role" key also works.
SUPABASE_SECRET_KEY=your-secret-key

# Public address of this website, used in sign-in emails.
# Set it to the live address when deployed. If blank, the request address is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic API key for the AI steps (not used yet in step 1).
ANTHROPIC_API_KEY=your-anthropic-api-key
